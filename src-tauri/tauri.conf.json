{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VELUM",
  "version": "../package.json",
  "identifier": "com.velum.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VELUM",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERkI0MjdGNDBERjUzREQKUldUZFU5OUFmMEw3UFJzSUI2RHJhRzRoY1RyWUUwTlJGb3ZzdURyRlphNUlya2d1Zm82bGRkaHkK",
      "endpoints": [
        "https://github.com/LaloSoftware/project-velum/releases/download/channels/beta.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
